# LLM backend config for the team LiteLLM proxy (default: Kimi-K2.6).
# Copy to configs/llm.kimi.env and fill in the key, OR source the box's
# env-profiles which already export CUSTOM_API_KEY. Never commit the real key.

ARBENCH_LLM_BACKEND=litellm
DEFAULT_API_BASE_URL=https://litellm.yangtzeailab.com/v1
ARBENCH_LLM_MODEL=Kimi-K2.6
CUSTOM_API_KEY=__PUT_KEY_HERE__

# Where mlebench prepares/grades data — keep on the project FS (NOT NFS home).
# MLEBENCH_DATA_DIR=/cs/student/project_msc/2025/csml/sruppage/thesis/mlebench-data
